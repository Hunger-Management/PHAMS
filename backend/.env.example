# Copy this file to .env and fill with your MySQL credentials
# Local MySQL example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=zero_hunger

# Railway / hosted MySQL examples (use whichever your provider gives you)
# DATABASE_URL=mysql://user:password@host:3306/zero_hunger
# MYSQLHOST=host
# MYSQLPORT=3306
# MYSQLUSER=user
# MYSQLPASSWORD=password
# MYSQLDATABASE=zero_hunger

# Optional: backend server port
PORT=3000
